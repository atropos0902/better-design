      ],
      "font-size": [
       "type.caption"
      ],
      "font-weight": [
       "weight.medium"
      ],
      "border-color": [
       "status.*"
      ],
      "border-radius": [
       "radius.control"
      ],
      "padding-inline": [
       "space.small"
      ],
      "padding-block": [
       "space.tight"
      ]
     }
    },
