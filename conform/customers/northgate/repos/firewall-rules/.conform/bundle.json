      ],
      "font-size": [
       "type.body"
      ],
      "font-weight": [
       "weight.regular",
       "weight.medium"
      ],
      "background-color": [
       "action.*",
       "surface.raised"
      ],
      "color": [
       "text.primary",
       "text.on-action",
       "status.critical"
      ],
      "border-color": [
       "border.*",
       "status.critical"
      ]
     }
    },
    {
     "part": "row",
