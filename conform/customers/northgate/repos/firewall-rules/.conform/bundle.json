      ],
      "font-weight": [
       "weight.bold"
      ],
      "color": [
       "text.primary"
      ]
     }
    },
    {
     "part": "card",
     "selector": "section, article",
     "props": {
      "padding-inline": [
       "card.padding"
      ],
      "padding-block": [
       "card.padding"
      ],
      "border-radius": [
       "radius.card"
      ],
      "background-color": [
       "surface.raised"
      ],
      "border-color": [
       "border.default"
      ],
      "box-shadow": [
       "elevation.raised"
      ],
      "gap": [
       "space.*"
      ]
     }
    },
    {
     "part": "dialog",
     "selector": "dialog, [role=dialog]",
     "props": {
      "padding-inline": [
       "card.padding"
      ],
      "padding-block": [
       "card.padding"
      ],
      "border-radius": [
       "radius.card"
      ],
      "background-color": [
       "surface.raised"
      ],
