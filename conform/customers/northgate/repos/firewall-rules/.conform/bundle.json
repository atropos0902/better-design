      ],
      "padding-inline": [
       "space.small",
       "space.medium"
      ]
     }
    },
    {
     "part": "cell",
     "selector": "td",
     "props": {
      "font-size": [
       "type.body"
      ],
      "padding-inline": [
       "space.small",
       "space.medium"
      ],
      "color": [
       "text.*",
       "status.*"
      ]
     }
    },
    {
     "part": "page-title",
     "selector": "h1",
     "props": {
      "font-size": [
       "type.title"
      ],
      "font-weight": [
       "weight.bold"
      ],
      "color": [
       "text.primary"
      ]
     }
    },
    {
     "part": "section-title",
