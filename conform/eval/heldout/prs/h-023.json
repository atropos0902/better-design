{
  "id": "h-023",
  "repo": "host-inventory",
  "title": "Pools screen",
  "body": "Lists pools with their size. New screen, linked from hosts later.",
  "files": {
    "conform.config.json": "{\n  \"repo\": \"northgate/host-inventory\",\n  \"bundle\": \".conform/bundle.json\",\n  \"keys\": \".conform/keys.json\",\n  \"styling\": \"tailwind\",\n  \"themeCss\": \".conform/theme.css\",\n  \"css\": [],\n  \"screens\": [\n    {\n      \"id\": \"hosts\",\n      \"module\": \"src/screens/hosts.tsx\"\n    },\n    {\n      \"id\": \"host\",\n      \"module\": \"src/screens/host.tsx\"\n    },\n    {\n      \"id\": \"pools\",\n      \"module\": \"src/screens/pools.tsx\"\n    }\n  ]\n}\n",
    "src/screens/pools.tsx": "type Pool = { name: string; size: number; state: \"ok\" | \"warn\" };\n\nconst pools: Pool[] = [\n  { name: \"web\", size: 24, state: \"ok\" },\n  { name: \"batch\", size: 8, state: \"warn\" },\n  { name: \"db\", size: 6, state: \"ok\" },\n];\n\nconst tone = {\n  ok: \"text-caption font-medium rounded-control px-small py-tight text-ok\",\n  warn: \"text-caption font-medium rounded-control px-small py-tight text-warn\",\n};\n\nexport default function Pools() {\n  return (\n    <main className=\"bg-surface-page p-section flex flex-col gap-large min-h-screen\">\n      <h1 className=\"text-title font-bold text-primary\">Pools</h1>\n      <div className=\"grid grid-cols-[2fr_1fr] gap-large items-start\">\n        <section data-testid=\"pool-list\" className=\"p-card rounded-card bg-surface-raised border border-default shadow-raised flex flex-col gap-medium\">\n          <h2 className=\"text-heading font-bold text-primary\">All pools</h2>\n          <table className=\"w-full table-fixed\">\n            <thead>\n              <tr>\n                <th className=\"text-caption font-medium text-muted px-medium text-left w-1/2\">Pool</th>\n                <th className=\"text-caption font-medium text-muted px-medium text-left\">Hosts</th>\n                <th className=\"text-caption font-medium text-muted px-medium text-left\">Status</th>\n              </tr>\n            </thead>\n            <tbody>\n              {pools.map((p) => (\n                <tr key={p.name} className=\"h-row border-b border-default\">\n                  <td className=\"text-body px-small text-primary\">{p.name}</td>\n                  <td className=\"text-body px-medium text-primary\">{p.size}</td>\n                  <td className=\"text-body px-medium text-primary\"><span data-status={p.state} className={tone[p.state]}>{p.state === \"ok\" ? \"Healthy\" : \"Below target\"}</span></td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </section>\n        <section data-testid=\"pool-new\" className=\"p-card rounded-card bg-surface-raised border border-default shadow-raised flex flex-col gap-medium\">\n          <h2 className=\"text-heading font-bold text-primary\">New pool</h2>\n          <div className=\"flex flex-col gap-tight min-w-0\">\n            <label htmlFor=\"pool-name\" className=\"text-caption font-medium text-muted\">Name</label>\n            <input id=\"pool-name\" data-testid=\"pool-name\" defaultValue=\"cache\" className=\"h-control px-control rounded-control text-body bg-surface-raised text-primary border border-strong w-full\" />\n          </div>\n          <button type=\"button\" data-testid=\"pool-create\" className=\"h-control px-control rounded-control text-body font-medium bg-action-primary hover:bg-action-primary-hover text-on-action w-full\">Create pool</button>\n        </section>\n      </div>\n    </main>\n  );\n}\n"
  },
  "plants": []
}
